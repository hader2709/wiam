# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_votre_token_botfather
# Segment secret dans l'URL du webhook, choisissez une chaine aleatoire longue
TELEGRAM_WEBHOOK_SECRET=changez-moi-avec-une-valeur-aleatoire

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-votre-cle
CLAUDE_MODEL=claude-sonnet-5

# --- Resend (notifications email) ---
RESEND_API_KEY=re_votre_cle
NOTIFY_EMAIL_FROM=agent@votredomaine.com
NOTIFY_EMAIL_TO=vous@votredomaine.com

# --- Google Sheets ---
# Contenu complet du fichier JSON du compte de service, sur UNE seule ligne
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# ID de la feuille (dans l'URL : https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=votre_id_de_feuille
